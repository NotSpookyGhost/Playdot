# Copy outside source to /mnt/user/appdata/playdot/config/stage0b.env.
# Values are configuration, never passwords or tokens.
PLAYDOT_DATA_ROOT=/mnt/user/appdata/playdot
PLAYDOT_PORT=41873
# Required Unraid LAN IP; replace locally before validating the identity stack.
KEYCLOAK_BIND_IP=REPLACE_WITH_UNRAID_LAN_IP
KEYCLOAK_HOST_PORT=41874
PLAYDOT_STAGE0B_APPROVED=no
CALLBACK_ALLOWED_HOSTS=REPLACE_WITH_VERIFIED_PLATFORM_CALLBACK_HOST
