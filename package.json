{
  "name": "playdot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres.test.ts",
    "spike": "tsx scripts/local-demo.ts",
    "start": "tsx apps/server/src/main.ts"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
