# Templates only. Do not create credentials or configure infrastructure in Stage 0A.
# No real values are supplied and this file is not automatically loaded.
DATABASE_URL=postgresql://<existing-user>:<existing-password>@<private-postgres>:5432/<spike-database>
OIDC_ISSUER=https://<approved-identity-provider>/<issuer-path>
OIDC_JWKS_URL=https://<approved-identity-provider>/<jwks-path>
MCP_RESOURCE=https://<approved-public-host>/mcp
# Protects callback secrets and private moderation-review submissions.
SUBSCRIPTION_KEY_BASE64=<separately-provisioned-32-byte-key-in-base64>
# Moderation defaults to local human review. No mock-allow or external-provider setting.
CALLBACK_ALLOWED_HOSTS=<verified-platform-callback-hostname>
