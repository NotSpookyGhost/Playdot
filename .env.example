# Compose configuration only. No passwords belong in this file.
PLAYDOT_DATA_ROOT=/mnt/user/appdata/playdot
PLAYDOT_PORT=41873
NODE_IMAGE=node:24.21.0-bookworm-slim
POSTGRES_IMAGE=postgres:17.11-bookworm
# Supply operator-managed secret files described in docs/unraid.md:
# <PLAYDOT_DATA_ROOT>/secrets/postgres_password (owner 999:999, mode 0400)
# <PLAYDOT_DATA_ROOT>/secrets/app_db_password (owner 1000:999, mode 0440)
# No credentials are generated or bundled. Compose hard-codes locked mode.
# Future Stage 0B settings, intentionally NOT passed into the installed service:
# PLAYDOT_MODE=oidc
# PLAYDOT_ENABLE_REAL_ROOMS=yes
# OIDC_ISSUER=https://<approved-identity-provider>/<issuer-path>
# OIDC_JWKS_URL=https://<approved-identity-provider>/<jwks-path>
# MCP_RESOURCE=https://playdot.bytedev.app/mcp
# SUBSCRIPTION_KEY_BASE64_FILE=/run/secrets/<approved-key-file>
# CALLBACK_ALLOWED_HOSTS=<verified-platform-callback-hostname>
# Existing direct local runtime may alternatively use DATABASE_URL or PG* vars.
